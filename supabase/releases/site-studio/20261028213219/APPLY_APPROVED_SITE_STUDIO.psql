-- BEGIN EXACT REVIEWED PROPOSAL (Git/LF bytes unchanged)
-- PROPOSAL ONLY. DO NOT APPLY TO PRODUCTION WITHOUT SEPARATE OWNER APPROVAL.
-- Site Studio v1 is owned by EVENTSible OS. It does not modify business/booking records.
create table if not exists public.os_site_media (
  id uuid primary key default gen_random_uuid(),
  drive_file_id text not null unique,
  title text not null,
  public_url text,
  alt_text text not null,
  usage_approved boolean not null default false,
  permission_confirmed boolean not null default false,
  status text not null default 'candidate' check (status in ('candidate','approved','retired')),
  created_at timestamptz not null default now(),
  constraint os_site_media_public_url_https check (
    public_url is null or (
      public_url ~ '^https://[^[:space:]]+$'
      and public_url !~* '^https://(drive[.]google[.]com|docs[.]google[.]com)/'
      and public_url !~* 'googleusercontent[.]com/'
    )
  ),
  constraint os_site_media_approved_only_with_review check (
    status <> 'approved' or (public_url is not null and usage_approved and permission_confirmed and length(trim(alt_text)) > 0)
  )
);

create table if not exists public.os_site_content_revisions (
  id uuid primary key default gen_random_uuid(),
  page_key text not null check (page_key = 'home'),
  revision bigint generated always as identity unique,
  state text not null default 'draft' check (state in ('draft','published','archived')),
  content jsonb not null,
  created_by uuid not null references auth.users(id),
  created_at timestamptz not null default now(),
  constraint os_site_content_object check (jsonb_typeof(content) = 'object')
);
create unique index if not exists os_site_only_one_published
  on public.os_site_content_revisions (page_key) where state = 'published';

alter table public.os_site_media enable row level security;
alter table public.os_site_content_revisions enable row level security;
revoke all on public.os_site_media from public, anon, authenticated;
revoke all on public.os_site_content_revisions from public, anon, authenticated;
grant select on public.os_site_media to authenticated;
grant select, insert on public.os_site_content_revisions to authenticated;
-- Supabase defaults can grant sequence UPDATE/USAGE to anon/authenticated.
-- Revoke inherited grants before granting only the draft-insert needs.
revoke all on sequence public.os_site_content_revisions_revision_seq from public, anon, authenticated;
grant usage, select on sequence public.os_site_content_revisions_revision_seq to authenticated;

create policy os_site_media_owner_select on public.os_site_media for select to authenticated
  using ((select auth.jwt() -> 'app_metadata' ->> 'role') = 'owner');
create policy os_site_content_owner_select on public.os_site_content_revisions for select to authenticated
  using ((select auth.jwt() -> 'app_metadata' ->> 'role') = 'owner');
create policy os_site_content_owner_insert on public.os_site_content_revisions for insert to authenticated
  with check ((select auth.jwt() -> 'app_metadata' ->> 'role') = 'owner'
    and created_by = (select auth.uid()) and state = 'draft'
    and length(content::text) <= 8000);

-- Publication is atomic and never exposed directly to a browser write.
create or replace function public.os_site_publish_revision(p_revision_id uuid)
returns uuid language plpgsql security definer set search_path = public, pg_temp as $$
declare target public.os_site_content_revisions%rowtype;
begin
  if auth.uid() is null or coalesce(auth.jwt() -> 'app_metadata' ->> 'role','') <> 'owner' then
    raise exception 'Owner authorization required' using errcode = '42501';
  end if;
  perform pg_advisory_xact_lock(hashtext('eventsible:site-studio:home'));
  select * into target from public.os_site_content_revisions
    where id = p_revision_id and page_key = 'home' and state in ('draft','archived')
    for update;
  if not found then raise exception 'Revision unavailable' using errcode = '22023'; end if;
  if nullif(trim(target.content ->> 'heading'),'') is null
    or nullif(trim(target.content ->> 'highlight'),'') is null
    or nullif(trim(target.content ->> 'subheading'),'') is null then
    raise exception 'Required homepage copy missing' using errcode = '22023';
  end if;
  if nullif(target.content ->> 'hero_media_id','') is not null
    and not exists (
      select 1 from public.os_site_media
      where id::text = target.content ->> 'hero_media_id'
      and status = 'approved' and usage_approved and permission_confirmed
    ) then
    raise exception 'Hero media not approved' using errcode = '22023';
  end if;
  if target.content ? 'gallery_media_ids' then
    if jsonb_typeof(target.content -> 'gallery_media_ids') <> 'array'
      or jsonb_array_length(target.content -> 'gallery_media_ids') > 3 then
      raise exception 'Invalid media gallery' using errcode = '22023';
    end if;
    if exists (
      select 1 from jsonb_array_elements_text(target.content -> 'gallery_media_ids') as selected(id)
      where not exists (
        select 1 from public.os_site_media as media where media.id::text = selected.id
        and media.status = 'approved' and media.usage_approved and media.permission_confirmed
        and media.public_url is not null
      )
    ) then
      raise exception 'Unapproved media gallery item' using errcode = '22023';
    end if;
  end if;
  if target.content ? 'section_order' and (
    jsonb_typeof(target.content -> 'section_order') <> 'array'
    or jsonb_array_length(target.content -> 'section_order') > 6
  ) then
    raise exception 'Invalid section order' using errcode = '22023';
  end if;
  if target.content ? 'visible_sections' and (
    jsonb_typeof(target.content -> 'visible_sections') <> 'array'
    or jsonb_array_length(target.content -> 'visible_sections') > 6
  ) then
    raise exception 'Invalid visible sections' using errcode = '22023';
  end if;
  update public.os_site_content_revisions set state = 'archived'
    where page_key = 'home' and state = 'published';
  update public.os_site_content_revisions set state = 'published' where id = target.id;
  return target.id;
end $$;
revoke all on function public.os_site_publish_revision(uuid) from public, anon;
grant execute on function public.os_site_publish_revision(uuid) to authenticated;

-- Owner-only private candidate intake; this does not approve, publish, download or share files.
create or replace function public.os_site_queue_drive_media(
  p_drive_file_id text, p_title text, p_alt_text text default ''
)
returns uuid language plpgsql security definer set search_path = '' as $$
declare
  result_id uuid;
begin
  if auth.uid() is null or coalesce(auth.jwt() -> 'app_metadata' ->> 'role','') <> 'owner' then
    raise exception 'Owner authorization required' using errcode = '42501';
  end if;
  if p_drive_file_id !~ '^[A-Za-z0-9_-]{12,120}$'
    or nullif(trim(p_title),'') is null or length(p_title) > 180
    or length(p_alt_text) > 240 then
    raise exception 'Invalid Drive candidate metadata' using errcode = '22023';
  end if;
  insert into public.os_site_media
    (drive_file_id,title,alt_text,status,permission_confirmed,usage_approved,public_url)
  values (p_drive_file_id,trim(p_title),trim(p_alt_text),'candidate',false,false,null)
  on conflict (drive_file_id) do update
    set title = excluded.title, alt_text = excluded.alt_text
    where os_site_media.status = 'candidate'
  returning id into result_id;
  if result_id is null then
    raise exception 'Reviewed media cannot be overwritten by an intake candidate' using errcode = '22023';
  end if;
  return result_id;
end $$;
revoke all on function public.os_site_queue_drive_media(text,text,text) from public, anon;
grant execute on function public.os_site_queue_drive_media(text,text,text) to authenticated;

-- Public reads occur only through the server-owned API, which selects the published revision.
-- Rollback requires explicit approval; do not drop published records or approved assets blindly.
-- END EXACT REVIEWED PROPOSAL

do $postflight$
declare t text; f text;
begin
  if (select count(*) from pg_class c join pg_namespace n on n.oid=c.relnamespace
      where n.nspname='public' and c.relname in ('os_site_media','os_site_content_revisions')
      and c.relkind='r' and c.relrowsecurity and pg_get_userbyid(c.relowner)='postgres') <> 2 then
    raise exception 'New table ownership or RLS mismatch';
  end if;
  if (select count(*) from pg_policy where polrelid in ('public.os_site_media'::regclass,'public.os_site_content_revisions'::regclass)) <> 3
     or not exists (select 1 from pg_index where indexrelid='public.os_site_only_one_published'::regclass and indisunique and indpred is not null)
     or (select count(*) from pg_constraint where conrelid='public.os_site_content_revisions'::regclass and contype='f' and confrelid='auth.users'::regclass) <> 1 then
    raise exception 'Policy, unique publication index or Auth foreign-key mismatch';
  end if;
  foreach t in array array['public.os_site_media','public.os_site_content_revisions'] loop
    if has_table_privilege('anon',t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
       or has_table_privilege('authenticated',t,'UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
       or not has_table_privilege('service_role',t,'SELECT')
       or not has_table_privilege('authenticated',t,'SELECT') then
      raise exception 'Table privilege boundary mismatch';
    end if;
  end loop;
  if has_table_privilege('authenticated','public.os_site_media','INSERT')
     or not has_table_privilege('authenticated','public.os_site_content_revisions','INSERT')
     or has_sequence_privilege('anon','public.os_site_content_revisions_revision_seq','USAGE,SELECT,UPDATE')
     or has_sequence_privilege('authenticated','public.os_site_content_revisions_revision_seq','UPDATE')
     or not has_sequence_privilege('authenticated','public.os_site_content_revisions_revision_seq','USAGE')
     or not has_sequence_privilege('authenticated','public.os_site_content_revisions_revision_seq','SELECT') then
    raise exception 'Draft or identity-sequence grant mismatch';
  end if;
  foreach f in array array['public.os_site_publish_revision(uuid)','public.os_site_queue_drive_media(text,text,text)'] loop
    if has_function_privilege('anon',f,'EXECUTE') or not has_function_privilege('authenticated',f,'EXECUTE')
       or not exists (select 1 from pg_proc where oid=to_regprocedure(f) and prosecdef and pg_get_userbyid(proowner)='postgres' and proconfig is not null) then
      raise exception 'Owner RPC permission or security-definer ownership mismatch';
    end if;
  end loop;
  if exists (select 1 from public.os_site_content_revisions) or exists (select 1 from public.os_site_media) then
    raise exception 'Migration must create empty Site Studio tables only';
  end if;
end $postflight$;
$canonical_migration$]::text[]);
